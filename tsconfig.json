{
  "compilerOptions": {
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ESNext",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["bun", "node"],
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["src", "test", "scripts"]
}
